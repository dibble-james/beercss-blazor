  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "provider": "jsdelivr",
      "library": "beercss@5.0.3",
      "destination": "wwwroot/beer",
      "files": [
        "dist/cdn/beer.scoped.min.css",
        "dist/cdn/beer.min.js",
