@attribute [Stories("Components/Shapes")]

<Stories TComponent="Shape">
    <Story Name="Default">
        <Arguments>
            <Arg For="x => x.ShapeType" Value="@("loading-indicator")" />
        </Arguments>
        <Template>
            <nav class="wrap">
                <Shape @attributes="context.Args"><div id="hello" class="tiny" data-id="hello"></div></Shape>
                <Shape @attributes="context.Args"><div></div></Shape>
                <Shape @attributes="context.Args"><div class="medium"></div></Shape>
                <Shape @attributes="context.Args"><div class="large"></div></Shape>
                <Shape @attributes="context.Args"><div class="extra"></div></Shape>
                <Shape @attributes="context.Args"><div class="extra"><img class="responsive" src="/favicon.png"></div></Shape>
                <Shape @attributes="context.Args"><div class="extra"><video class="responsive" autoplay="" loop="" playsinline=""><source src="/dance.mp4" type="video/mp4"></video></div></Shape>
                <Shape @attributes="context.Args"><div class="extra"><button class="responsive"><i>search</i></button></div></Shape>
                <Shape @attributes="context.Args"><div class="extra transparent"><button class="responsive"><i>search</i></button></div></Shape>
            </nav>
        </Template>
    </Story>
    <Story Name="Types">
        <Template>
            <nav class="wrap">
                <Shape ShapeType="ShapeTypes.Arch"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Arrow"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Boom"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Bun"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Burst"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Circle"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Clamshell"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Diamond"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Fan"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Flower"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Gem"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.GhostIsh"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Heart"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.LeafClover4"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.LeafClover8"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.LoadingIndicator"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Oval"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Pentagon"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Pill"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.PixelCircle"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.PixelTriangle"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Puffy"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.PuffyDiamond"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Semicircle"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.SidedCookie4"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.SidedCookie6"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.SidedCookie7"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.SidedCookie9"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.SidedCookie12"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Slanted"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.SoftBoom"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.SoftBurst"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Square"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Sunny"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.Triangle"><div class="medium"></div></Shape>
                <Shape ShapeType="ShapeTypes.VerySunny"><div class="medium"></div></Shape>
            </nav>
        </Template>
    </Story>
    <Story Name="Sizes">
        @*
            BeerCSS 5 has no .shape.small rule: Size.Small and the Size.Medium default both land on
            the bare .shape size, so only tiny, large and extra change it.
        *@
        <Template>
            <nav class="wrap">
                <Shape ShapeType="ShapeTypes.Puffy" Size="Size.Tiny"><div></div></Shape>
                <Shape ShapeType="ShapeTypes.Puffy" Size="Size.Small"><div></div></Shape>
                <Shape ShapeType="ShapeTypes.Puffy" Size="Size.Medium"><div></div></Shape>
                <Shape ShapeType="ShapeTypes.Puffy" Size="Size.Large"><div></div></Shape>
                <Shape ShapeType="ShapeTypes.Puffy" Size="Size.Extra"><div></div></Shape>
            </nav>
        </Template>
    </Story>
    <Story Name="Rotations">
        <Template>
            <nav class="wrap">
                <Shape ShapeType="ShapeTypes.Puffy" Rotate="Rotation.Rotate"><div></div></Shape>
                <Shape ShapeType="ShapeTypes.Puffy" Rotate="Rotation.Fast"><div></div></Shape>
                <Shape ShapeType="ShapeTypes.Puffy" Rotate="Rotation.Slow"><div></div></Shape>
            </nav>
        </Template>
    </Story>
</Stories>
