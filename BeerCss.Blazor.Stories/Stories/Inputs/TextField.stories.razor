@using BeerCss.Blazor.Components.Inputs
@attribute [Stories("Components/Inputs/Text")]

<Stories TComponent="TextField">
    <ArgType For="_ => _.Size" Control="ControlType.Select" DefaultValue="Size.Medium" />

    <Story Name="Default">
        <Template>
            <EditForm Context="form" Model="_value">
                <TextField TValue="int" @attributes="context.Args" @bind-Value="_value" />
            </EditForm>
        </Template>
    </Story>

    <Story Name="Help text">
        <Arguments>
            <Arg For="x => x.HelpText" Value="_helpText" />
        </Arguments>
        <Template>
            <EditForm Context="form" Model="_value">
                <TextField TValue="int" @attributes="context.Args" @bind-Value="_value" />
            </EditForm>
        </Template>
    </Story>

    <Story Name="Rounding">
        <Template>
            <EditForm Context="form" Model="_value">
                <Grid>
                    <div class="s6">
                        <TextField TValue="int" @bind-Value="_value" Label="Default" />
                    </div>
                    <div class="s6">
                        <TextField TValue="int" @bind-Value="_value" Rounding="Rounding.Round" Label="Round" />
                    </div>
                    <div class="s6">
                        <TextField TValue="int" @bind-Value="_value" Rounding="Rounding.NoRound" Label="No round" />
                    </div>
                    <div class="s6">
                        <TextField TValue="int" @bind-Value="_value" Rounding="Rounding.LeftRound" Label="Left round" />
                    </div>
                    <div class="s6">
                        <TextField TValue="int" @bind-Value="_value" Rounding="Rounding.RightRound" Label="Right round" />
                    </div>
                    <div class="s6">
                        <TextField TValue="int" @bind-Value="_value" Rounding="Rounding.NoRoundLeft" Label="No round left" />
                    </div>
                    <div class="s6">
                        <TextField TValue="int" @bind-Value="_value" Rounding="Rounding.NoRoundRight" Label="No round right" />
                    </div>
                </Grid>
            </EditForm>
        </Template>
    </Story>

    <Story Name="Invalid">
        <Template>
            <EditForm Context="form" EditContext="_editContext">
                <TextField TValue="int" @attributes="context.Args" @bind-Value="_invalidValue" />
            </EditForm>
        </Template>
    </Story>
</Stories>

@code {
    string? _value = "Text value";
    string? _invalidValue = "Text value";
    string _helpText = "Help me!";
    EditContext? _editContext;    

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_invalidValue!);
        var messageStore = new ValidationMessageStore(_editContext);
        messageStore.Add(() => _invalidValue!, "You ain't valid son");
    }
}