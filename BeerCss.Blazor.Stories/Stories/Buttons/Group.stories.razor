@using BeerCss.Blazor.Components.Buttons;
@attribute [Stories("Components/Buttons/Group")]

<Stories TComponent="Group">
    <Story Name="Default">
        <Template>
            <Group @attributes="context.Args">
                <Button>Left</Button>
                <Button>Middle</Button>
                <Button>Right</Button>
            </Group>
        </Template>
    </Story>
    <Story Name="Edge rounding">
        <Template>
            @* v5 handles the interior corners itself, so interior buttons no longer need
               no-round; only the outer edges are rounded. *@
            <Group Connected>
                <Button Rounding="Rounding.LeftRound">Left</Button>
                <Button>Middle</Button>
                <Button Rounding="Rounding.RightRound">Right</Button>
            </Group>
        </Template>
    </Story>
    <Story Name="Connected">
        <Arguments>
            <Arg For="x => x.Connected" Value="true" />
        </Arguments>
        <Template>
            <Group @attributes="context.Args">
                <Button>Left</Button>
                <Button>Middle</Button>
                <Button>Right</Button>
            </Group>
        </Template>
    </Story>
</Stories>