@using BeerCss.Blazor.Components.Buttons;
@attribute [Stories("Components/Buttons/Button")]

<Stories TComponent="Button">
    <ArgType For="_ => _.Size" Control="ControlType.Select" DefaultValue="Size.Medium" />
    <ArgType For="_ => _.Elevation" Control="ControlType.Select" DefaultValue="Elevation.NoElevate" />
    <ArgType For="_ => _.Color" Control="ControlType.Select" DefaultValue="Color.Default" />
    <ArgType For="_ => _.Rounding" Control="ControlType.Select" DefaultValue="Rounding.Default" />

    <Story Name="Default">
        <Arguments>
            <Arg For="x => x.ChildContent" Value="_childContent" />
        </Arguments>
        <Template>
            <Button @attributes="context.Args"></Button>
        </Template>
    </Story>
    <Story Name="Rounding">
        <Template>
            <div class="row wrap">
                <Button>Default</Button>
                <Button Rounding="Rounding.Round">Round</Button>
                <Button Rounding="Rounding.NoRound">No round</Button>
                <Button Rounding="Rounding.LeftRound">Left round</Button>
                <Button Rounding="Rounding.RightRound">Right round</Button>
                <Button Rounding="Rounding.NoRoundLeft">No round left</Button>
                <Button Rounding="Rounding.NoRoundRight">No round right</Button>
            </div>
        </Template>
    </Story>
    <Story Name="Responsive">
        <Arguments>
            <Arg For="x => x.ChildContent" Value="_childContent" />
        </Arguments>
        <Template>
            <Button Responsive @attributes="context.Args"></Button>
        </Template>
    </Story>
</Stories>

@code
{
    RenderFragment _childContent = @<text>I am button</text>;
}