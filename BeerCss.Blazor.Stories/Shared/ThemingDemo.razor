@inject NavigationManager Navigation
@* Host for the story: a palette the library does not ship, and its dark counterpart. BeerCSS sets the
   same token names at element scope, which outranks :root, so a mode class that did not carry the
   palette with it would hand the built-in one back — and this canvas would stop looking teal. *@
<Beer Theme="_brandLight" DarkTheme="_brandDark" Mode="@StoryQuery.ReadMode(Navigation)">
    <main class="responsive">
        <Card>
            <Title>Brand palette</Title>
            <Content>
                Every token here comes from a <code>BeerTheme</code> this story supplies, not from the
                palette the library ships, in both modes.
            </Content>
        </Card>
        <nav>
            <Button>Primary</Button>
            <Button class="secondary">Secondary</Button>
            <Button class="tertiary">Tertiary</Button>
        </nav>
    </main>
</Beer>

