@code {
    /// <summary>
    /// Shows the overlay. An inactive overlay is still in the document but has no opacity and no
    /// visibility, so it never catches a click.
    /// </summary>
    [Parameter]
    public bool Active { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object> AdditionalAttributes { get; set; } = new Dictionary<string, object>();

    private CssBuilder CssClass => new CssBuilder()
        .AddClass("overlay")
        .AddClass("active", Active)
        .AddClassFromAttributes(AdditionalAttributes);
}

<div @attributes="AdditionalAttributes" class="@CssClass"></div>
